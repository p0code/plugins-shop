{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p0code.github.io/plugins-shop/plugin.schema.json",
  "title": "p0code plugin shop entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "author",
    "repoUrl",
    "license",
    "categories",
    "latestVersion",
    "versions",
    "source",
    "verified"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "description": "The plugin manifest id. The file must be named plugins/<id>.json.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "name": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
    "description": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
    "longDescription": { "type": "string", "minLength": 1 },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "repoUrl": {
      "description": "The GitHub repo holding the plugin source.",
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9-]+/[A-Za-z0-9._-]+$"
    },
    "homepage": { "type": "string", "format": "uri", "pattern": "^https://" },
    "license": {
      "description": "SPDX expression, or NOASSERTION when the repo has no license.",
      "type": "string",
      "minLength": 1
    },
    "categories": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "iconUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "screenshotUrls": {
      "type": "array",
      "items": { "type": "string", "format": "uri", "pattern": "^https://" }
    },
    "latestVersion": {
      "description": "Must be the newest entry in versions.",
      "type": "string",
      "minLength": 1
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "bundleUrl",
          "sha256",
          "capabilities",
          "sizeBytes",
          "publishedAt"
        ],
        "properties": {
          "version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
          "bundleUrl": {
            "description": "A .tgz or .zip holding manifest.json and plugin.mjs.",
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "sha256": {
            "description": "SHA-256 of the bundle bytes, lowercase hex.",
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "apiVersion": { "type": "integer", "minimum": 1 },
          "capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "network:outbound",
                "process:spawn",
                "http:routes",
                "auth:issue-device-credentials",
                "orchestration:read-activity",
                "usage:read",
                "data:backup",
                "agent:instructions"
              ]
            }
          },
          "sizeBytes": { "type": "integer", "minimum": 0 },
          "publishedAt": { "type": "string", "minLength": 1 },
          "releaseNotesUrl": { "type": "string", "format": "uri", "pattern": "^https://" }
        }
      }
    },
    "source": {
      "description": "official only for repos owned by p0code or jsserve-org.",
      "enum": ["official", "community"]
    },
    "verified": {
      "description": "True only for repos owned by p0code. This is a publisher badge, not an audit.",
      "type": "boolean"
    }
  }
}
